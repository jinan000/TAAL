# ════════════════════════════════════════════════════════════════
# TAAL DANCE ACADEMY — BACKEND ENVIRONMENT CONFIGURATION
# ════════════════════════════════════════════════════════════════

# Resend API Key (Get yours at https://resend.com/api-keys)
RESEND_API_KEY=re_123456789_your_resend_api_key

# Destination email where all website submissions are delivered
RECIPIENT_EMAIL=infoattaaldanceacademy@gmail.com

# Sender email address
# Default (Unverified domain testing): TAAL Dance Academy <onboarding@resend.dev>
# Production (Verified domain): TAAL Dance Academy <notifications@taaldanceacademy.com>
SENDER_EMAIL=TAAL Dance Academy <onboarding@resend.dev>

# Allowed Origin for Production CORS (e.g., https://taaldanceacademy.com)
ALLOWED_ORIGIN=http://localhost:5173

# Server Port (for standalone Node Express server)
PORT=3001
