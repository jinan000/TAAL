# ════════════════════════════════════════════════════════════════
# TAAL DANCE ACADEMY — ENVIRONMENT CONFIGURATION
# ════════════════════════════════════════════════════════════════

# ── Backend (Server-side only — set in Vercel Dashboard) ───────

# Resend API Key (Get yours at https://resend.com/api-keys)
# NEVER put this in VITE_ variables — it must stay server-side only.
RESEND_API_KEY=

# Destination email where all website submissions are delivered
RECIPIENT_EMAIL=infoattaaldanceacademy@gmail.com

# Sender email address (must be on a verified Resend domain)
SENDER_EMAIL=TAAL Dance Academy <no-reply@taaldanceacademy.ca>

# Allowed Origins for CORS (comma-separated)
ALLOWED_ORIGIN=https://taaldanceacademy.ca,https://www.taaldanceacademy.ca

# Server Port (for standalone local Express server)
PORT=3001

# ── Frontend (Exposed to browser — safe for public URLs) ───────

# Production API URL — your Vercel deployment URL
# Leave empty for local development (Vite proxy handles /api)
VITE_API_URL=
